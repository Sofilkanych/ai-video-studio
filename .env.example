# Скопіювати у .env і заповнити. .env не комітити.

# Claude API (Commercial Terms) — обов'язково для робочих матеріалів (див. CLAUDE.md → Data policy).
ANTHROPIC_API_KEY=

# ElevenLabs — синтез голосу в режимі «сценарій» (input/script.md або нотатки PPTX).
# VOICE_ID — ідентифікатор вашого клонованого голосу (ElevenLabs → Voices → ID).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# OpenRouter — лише з Фази 3 (generated assets). Поки data_policy.external_generation=false, не потрібен.
OPENROUTER_API_KEY=
