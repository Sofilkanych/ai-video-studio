{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timeline.schema.json",
  "title": "Timeline",
  "type": "object",
  "required": ["version", "fps", "width", "height", "duration", "scenes"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^v[0-9]{3}$"},
    "fps": {"type": "integer", "minimum": 1},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "duration": {"type": "number", "exclusiveMinimum": 0},
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "position": {"enum": ["bottom", "top"]},
        "scale": {"type": "number", "minimum": 0.5, "maximum": 2}
      }
    },
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}}
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["scene_id", "start", "end", "layout"],
      "additionalProperties": false,
      "properties": {
        "scene_id": {"type": "string", "pattern": "^s[0-9]+$"},
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "exclusiveMinimum": 0},
        "slide": {"type": ["integer", "null"], "minimum": 1},
        "layout": {"enum": ["slide_inset", "slide_full", "presenter_full", "side_by_side", "free_zone"]},
        "presenter": {
          "type": ["object", "null"],
          "required": ["shape", "position", "scale"],
          "additionalProperties": false,
          "properties": {
            "shape": {"enum": ["circle", "rect"]},
            "position": {"enum": ["bottom-right", "bottom-left", "top-right", "top-left"]},
            "scale": {"type": "number", "minimum": 0.1, "maximum": 0.5}
          }
        },
        "transition_in": {"enum": ["cut", "fade", "slide", "zoom"]},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "generated_assets": {"type": "array", "items": {"type": "string"}},
        "sync_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "action": {
      "type": "object",
      "required": ["at", "type", "target"],
      "additionalProperties": false,
      "properties": {
        "at": {"type": "number", "minimum": 0},
        "until": {"type": "number", "minimum": 0},
        "type": {"enum": ["zoom", "highlight", "callout", "table_reveal"]},
        "target": {
          "type": "string",
          "description": "element_id з slide_manifest.json (MVP: фігура або комірка таблиці).",
          "pattern": "^slide[0-9]+/[A-Za-z0-9_/]+$"
        },
        "text": {"type": "string"}
      }
    }
  }
}
