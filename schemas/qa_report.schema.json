{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa_report.schema.json",
  "title": "QA report",
  "type": "object",
  "required": ["status", "timeline_version", "issues"],
  "additionalProperties": false,
  "properties": {
    "status": {"enum": ["pass", "fail"]},
    "timeline_version": {"type": "string", "pattern": "^v[0-9]{3}$"},
    "stage": {"enum": ["preview", "final"]},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "check", "severity"],
        "additionalProperties": false,
        "properties": {
          "scene_id": {"type": "string"},
          "time": {"type": "number", "minimum": 0},
          "type": {
            "enum": [
              "overlap", "caption_safe_area", "callout_out_of_frame",
              "black_frames", "frozen_presenter", "unexpected_silence",
              "duration_mismatch", "frame_count_mismatch", "format",
              "loudness", "clipping", "missing_media", "semantic"
            ]
          },
          "check": {"enum": ["technical", "geometric", "semantic"]},
          "severity": {"enum": ["low", "medium", "high"]},
          "detail": {"type": "string"},
          "fix": {"type": "string"}
        }
      }
    }
  }
}
