{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production_plan.schema.json",
  "title": "Production plan",
  "type": "object",
  "required": ["title", "chapters"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string"},
    "audience": {"type": "string"},
    "pacing": {"enum": ["calm", "moderate", "dynamic"]},
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chapter_id", "title", "start", "end", "slides", "key_points"],
        "additionalProperties": false,
        "properties": {
          "chapter_id": {"type": "string", "pattern": "^c[0-9]+$"},
          "title": {"type": "string"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "slides": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "key_points": {"type": "array", "items": {"type": "string"}},
          "visual_ideas": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "external_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "kind", "reason", "prompt"],
        "additionalProperties": false,
        "properties": {
          "asset_id": {"type": "string"},
          "kind": {"enum": ["image", "video"]},
          "reason": {"type": "string"},
          "prompt": {"type": "string"},
          "high_impact": {"type": "boolean"}
        }
      }
    }
  }
}
